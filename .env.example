DATABASE_URL=postgres://bangkebank:bangkebank@localhost:55432/bangkebank
# Set to "true" for a remote database; TLS then verifies the server certificate.
DATABASE_SSL=false
# Generate with: openssl rand -base64 32 (the app refuses to start with this placeholder)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Encrypts NIK, date of birth and address at rest. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# Keys the hash of partner API key secrets. Generate with: openssl rand -base64 32
API_KEY_PEPPER=
